# Copy to .env and fill in. Never commit .env.
# Hugging Face token with write access (model publishing, Spaces deploy)
HF_TOKEN=
# Copernicus Data Space Ecosystem (either pair suffices; OAuth client preferred)
# Option 1 — dashboard OAuth client (client_credentials grant):
# CDSE_CLIENT_ID=
# CDSE_CLIENT_SECRET=
# Option 2 — account login (password grant, client_id=cdse-public):
CDSE_USER=
CDSE_PASS=

# --- SIH Prototype V2 store (optional override; default is prototype.db) ---
# OILSPILL_API_PROTOTYPE_DB=prototype.db
# --- YOLO Detector (optional override; default is artifacts/yolo/best.pt) ---
# OILSPILL_API_YOLO_WEIGHTS=C:\path\to\best.pt
OILSPILL_API_YOLO_CONF_THRESHOLD=0.25
OILSPILL_API_YOLO_IOU_THRESHOLD=0.45
